# Static assets - serve files directly
/assets/*  /assets/:splat  200
/web-apps/*  /web-apps/:splat  200
/img/*  /img/:splat  200
/fonts/*  /fonts/:splat  200
/sdkjs/*  /sdkjs/:splat  200
/wasm/*  /wasm/:splat  200

# Ensure query parameters are preserved for editor.html
/editor.html* /editor.html:splat 200

# Handle SPA routing - fallback to index.html for unmatched routes
/* /index.html 200
