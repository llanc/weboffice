# Static assets - serve files directly
/document/assets/*  /document/assets/:splat  200
/document/web-apps/*  /document/web-apps/:splat  200
/document/img/*  /document/img/:splat  200
/document/fonts/*  /document/fonts/:splat  200
/document/sdkjs/*  /document/sdkjs/:splat  200
/document/wasm/*  /document/wasm/:splat  200

# SPA fallback - serve index.html for all other routes
/document/*  /document/index.html  200
